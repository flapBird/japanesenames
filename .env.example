# Google Analytics 4 Measurement ID (public identifier, not a secret)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional server-only AI intent parser. Without these values, the AI name
# generator remains usable through its local keyword-parser fallback.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
# responses (default) or chat_completions for compatible providers
AI_API_STYLE=responses
# json_schema (default) or json_object for providers without Structured Outputs
AI_RESPONSE_FORMAT=json_schema
# Optional output budget, clamped to 200–2,000 tokens. json_object defaults to 1,200.
AI_MAX_OUTPUT_TOKENS=400
# Optional timeout, clamped to 2,000–15,000 milliseconds
AI_TIMEOUT_MS=8000
# Emergency kill switch. The feature is enabled unless explicitly set to false.
AI_NAME_GENERATOR_ENABLED=true
